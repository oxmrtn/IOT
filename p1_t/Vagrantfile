Vagrant.configure("2") do |config|

  # ============================================================
  # Configuration générale
  # ============================================================

  # Ubuntu 26.04 LTS - dernière LTS stable
  config.vm.box = "ubuntu/resolute64"

  # Vagrant utilise une clé SSH au lieu d'un mot de passe.
  config.ssh.insert_key = true

  # ============================================================
  # K3s configuration
  # ============================================================

  # Token partagé entre le Server et le ServerWorker.
  #
  # Pour ce projet, il est volontairement défini dans le
  # Vagrantfile afin que le provisioning soit reproductible.
  #
  # En production, ce secret ne devrait évidemment pas être
  # stocké directement dans le Vagrantfile.
  k3s_token = "K3sProjectToken-2026-ChangeMe"

  # Adresse du serveur K3s
  k3s_server_ip = "192.168.56.110"

  # ============================================================
  # SERVER
  # ============================================================

  config.vm.define "mtrullarS" do |server|

    # Nom d'hôte
    server.vm.hostname = "mtrullarS"

    # Réseau privé avec IP statique
    server.vm.network "private_network",
      ip: k3s_server_ip

    # Ressources minimales demandées
    server.vm.provider "virtualbox" do |vb|
      vb.name = "mtrullarS"
      vb.cpus = 1
      vb.memory = 1024
    end

    # Installation de K3s en mode Server / Controller
    server.vm.provision "shell", inline: <<-SHELL
      set -eux

      echo "=========================================="
      echo " Installing K3s Server"
      echo "=========================================="

      # Mise à jour des paquets
      apt-get update

      # curl est nécessaire pour l'installateur K3s
      apt-get install -y curl

      # Installation de K3s en mode server/controller
      #
      # K3S_TOKEN définit le secret utilisé par les
      # futurs agents pour rejoindre le cluster.
      K3S_TOKEN="#{k3s_token}" \
        curl -sfL https://get.k3s.io | sh -s - server \
          --node-ip=#{k3s_server_ip}

      echo ""
      echo "K3s Server installed successfully."
      echo ""

      # Vérification du service
      systemctl is-active --quiet k3s

      echo "K3s service is running."
      echo ""

      # Affichage des nodes
      kubectl get nodes
    SHELL
  end

  # ============================================================
  # SERVER WORKER
  # ============================================================

  config.vm.define "mtrullarSW" do |worker|

    # Nom d'hôte
    worker.vm.hostname = "mtrullarSW"

    # Réseau privé avec IP statique
    worker.vm.network "private_network",
      ip: "192.168.56.111"

    # Ressources minimales demandées
    worker.vm.provider "virtualbox" do |vb|
      vb.name = "mtrullarSW"
      vb.cpus = 1
      vb.memory = 1024
    end

    # Installation de K3s en mode Agent
    worker.vm.provision "shell", inline: <<-SHELL
      set -eux

      echo "=========================================="
      echo " Installing K3s Agent"
      echo "=========================================="

      # Mise à jour des paquets
      apt-get update

      # curl est nécessaire pour l'installateur K3s
      apt-get install -y curl

      echo "Waiting for K3s Server..."

      # On attend que l'API Kubernetes du Server soit disponible.
      #
      # Cela évite que l'installation de l'agent échoue simplement
      # parce que le Server n'a pas encore terminé son démarrage.
      until curl -k -s \
        --connect-timeout 2 \
        https://#{k3s_server_ip}:6443/readyz \
        >/dev/null 2>&1
      do
        sleep 3
      done

      echo "K3s Server is available."

      # Installation de K3s en mode agent.
      #
      # La présence de K3S_URL fait comprendre à l'installateur
      # qu'il doit installer un agent et non un second serveur.
      K3S_URL="https://#{k3s_server_ip}:6443" \
      K3S_TOKEN="#{k3s_token}" \
        curl -sfL https://get.k3s.io | sh -s - agent \
          --node-ip=192.168.56.111

      echo ""
      echo "K3s Agent installed successfully."
      echo ""

      # Vérification du service
      systemctl is-active --quiet k3s-agent

      echo "K3s agent service is running."
    SHELL
  end

end
