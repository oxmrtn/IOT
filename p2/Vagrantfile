LOGIN     = "mtrullar"
IP_SERVER = "192.168.56.110"
GATEWAY   = "192.168.56.1"

Vagrant.configure("2") do |config|
  config.vm.box = "generic/centos9s"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "libvirt" do |lv|
    lv.driver = "kvm"
    lv.memory = 2048
    lv.cpus   = 2
  end

  config.vm.define "#{LOGIN}S" do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: IP_SERVER
    server.vm.provision "file", source: "confs", destination: "/tmp/confs"
    server.vm.provision "shell", inline: <<-SHELL
      nmcli con mod "$(nmcli -g GENERAL.CONNECTION dev show eth0)" ipv4.never-default yes
      nmcli con mod "$(nmcli -g GENERAL.CONNECTION dev show eth1)" ipv4.gateway #{GATEWAY}
      nmcli dev reapply eth0
      nmcli dev reapply eth1
      systemctl disable --now firewalld
      curl -sfL https://get.k3s.io | sh -s - server \
        --node-ip=#{IP_SERVER} --flannel-iface=eth1 --write-kubeconfig-mode=644
      until /usr/local/bin/kubectl get nodes 2>/dev/null | grep -q " Ready"; do sleep 2; done
      /usr/local/bin/kubectl apply -f /tmp/confs/
    SHELL
  end
end
