# -*- mode: ruby -*-
# vi: set ft=ruby :

BOX    = "generic/centos7"
MEMORY = 1024
CPUS   = 1

LOGIN  = "mtrullar"
MASTER = "#{LOGIN}S"
WORKER = "#{LOGIN}SW"

IP_MASTER = "192.168.56.110"
IP_WORKER = "192.168.56.111"
K3S_TOKEN = "iot-lab-shared-token"

# CentOS 7 est EOL : les depots par defaut (mirrorlist.centos.org) ne repondent plus.
# On bascule sur vault.centos.org avant toute installation de paquet.
repo_fix = <<-SHELL
    sed -i 's/mirrorlist/#mirrorlist/g' /etc/yum.repos.d/CentOS-*.repo
    sed -i 's|#baseurl=http://mirror.centos.org|baseurl=http://vault.centos.org|g' /etc/yum.repos.d/CentOS-*.repo
SHELL

# Modules kernel : chargement immediat + persistance au boot (equivalent /etc/modules d'Alpine)
kernel_modules = <<-SHELL
    modprobe overlay 2>/dev/null || true
    modprobe br_netfilter 2>/dev/null || true
    cat <<-EOF | sudo tee /etc/modules-load.d/k3s.conf
overlay
br_netfilter
EOF
SHELL

master_script = <<-SHELL
    set -e
    #{repo_fix}
    yum install -y curl

    #{kernel_modules}

    # Desactive firewalld (ou configure les ports necessaires a k3s si tu preferes le garder actif)
    systemctl disable --now firewalld 2>/dev/null || true

    # SELinux en mode permissif pour eviter les blocages k3s (sinon installer le paquet k3s-selinux)
    setenforce 0 2>/dev/null || true
    sed -i 's/^SELINUX=enforcing/SELINUX=permissive/' /etc/selinux/config 2>/dev/null || true

    curl -sfL https://get.k3s.io | \
      K3S_TOKEN=#{K3S_TOKEN} \
      INSTALL_K3S_EXEC="server --node-ip=#{IP_MASTER} --write-kubeconfig-mode=644 --flannel-iface=eth1" \
      sh -
SHELL

worker_script = <<-SHELL
    set -e
    #{repo_fix}
    yum install -y curl

    #{kernel_modules}

    systemctl disable --now firewalld 2>/dev/null || true
    setenforce 0 2>/dev/null || true
    sed -i 's/^SELINUX=enforcing/SELINUX=permissive/' /etc/selinux/config 2>/dev/null || true

    until curl -ks -o /dev/null https://#{IP_MASTER}:6443; do
      sleep 3
    done

    curl -sfL https://get.k3s.io | \
      K3S_URL=https://#{IP_MASTER}:6443 \
      K3S_TOKEN=#{K3S_TOKEN} \
      INSTALL_K3S_EXEC="agent --node-ip=#{IP_WORKER} --flannel-iface=eth1" \
      sh -
SHELL

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.memory = MEMORY
    vb.cpus   = CPUS
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    vb.customize ["modifyvm", :id, "--natdnsproxy1", "on"]
    vb.customize ["guestproperty", "set", :id, "/VirtualBox/GuestAdd/VBoxService/--timesync-set-threshold", 10000]
    vb.customize ["modifyvm", :id, "--paravirtprovider", "minimal"]
    vb.customize ["modifyvm", :id, "--nested-paging", "off"]
    vb.customize ["modifyvm", :id, "--pae", "on"]
  end

  config.vm.define MASTER do |master|
    master.vm.hostname = MASTER
    master.vm.network "private_network", ip: IP_MASTER
    master.vm.provision "shell", inline: master_script
  end

  config.vm.define WORKER do |worker|
    worker.vm.hostname = WORKER
    worker.vm.network "private_network", ip: IP_WORKER
    worker.vm.provision "shell", inline: worker_script
  end
end
