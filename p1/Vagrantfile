LOGIN     = "mtrullar"
IP_MASTER = "192.168.56.110"
IP_WORKER = "192.168.56.111"
K3S_TOKEN = "iot-lab-shared-token"

Vagrant.configure("2") do |config|
  config.vm.box = "generic/centos9s"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "libvirt" do |lv|
    lv.driver = "kvm"
    lv.memory = 1024
    lv.cpus   = 1
  end

  config.vm.define "#{LOGIN}S" do |master|
    master.vm.hostname = "#{LOGIN}S"
    master.vm.network "private_network", ip: IP_MASTER
    master.vm.provision "shell", inline: <<-SHELL
      systemctl disable --now firewalld
      curl -sfL https://get.k3s.io | K3S_TOKEN=#{K3S_TOKEN} sh -s - server \
        --node-ip=#{IP_MASTER} --flannel-iface=eth1 --write-kubeconfig-mode=644
    SHELL
  end

  config.vm.define "#{LOGIN}SW" do |worker|
    worker.vm.hostname = "#{LOGIN}SW"
    worker.vm.network "private_network", ip: IP_WORKER
    worker.vm.provision "shell", inline: <<-SHELL
      systemctl disable --now firewalld
      curl -sfL https://get.k3s.io | K3S_URL=https://#{IP_MASTER}:6443 K3S_TOKEN=#{K3S_TOKEN} sh -s - agent \
        --node-ip=#{IP_WORKER} --flannel-iface=eth1
    SHELL
  end
end
